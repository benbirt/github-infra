load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_python//python/uv:lock.bzl", "lock")

# `bazel run //schema:requirements.update` rewrites requirements.txt from
# requirements.in.
lock(
    name = "requirements",
    srcs = ["requirements.in"],
    out = "requirements.txt",
)

# Checks the compiled repository list against repos.schema.json.
py_console_script_binary(
    name = "repos_test",
    args = [
        "--schemafile",
        "$(rootpath repos.schema.json)",
        "$(rootpath //:repos)",
    ],
    binary_rule = py_test,
    data = [
        "repos.schema.json",
        "//:repos",
    ],
    legacy_create_init = 0,
    pkg = "@github_infra_pip//check_jsonschema",
    script = "check-jsonschema",
)
