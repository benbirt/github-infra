{
  "$schema": "repos.schema.json",
  "managed": {
    "bazel-style": {
      "build": "bazel",
      "required_checks": ["test"],
      "dependabot": ["npm", "pip", "github-actions"]
    },
    "benbirt.io": {
      "build": "bazel",
      "required_checks": ["build"],
      "dependabot": ["opentofu", "github-actions"],
      "pages": { "target": "//site:public", "domain": "benbirt.io" },
      "tofu": ["//infra:infra"]
    },
    "eavesbard": {
      "build": "bazel",
      "required_checks": ["build"],
      "dependabot": ["npm", "opentofu", "github-actions"],
      "pages": { "target": "//src:site", "domain": "eavesbard.com" },
      "tofu": ["//dns:dns", "//posthog:posthog"]
    },
    "flip7-scorecard": {
      "build": "bazel",
      "required_checks": ["test"],
      "dependabot": ["github-actions"],
      "pages": { "target": "//:public", "domain": "flip7.benbirt.io" }
    },
    "github-infra": {
      "build": "none",
      "required_checks": ["lint"],
      "dependabot": ["github-actions"]
    },
    "rules_tofu": {
      "build": "bazel",
      "required_checks": [
        "lint",
        "build-and-test (ubuntu-latest, pinned)",
        "build-and-test (ubuntu-latest, 8.5.0)",
        "build-and-test (macos-latest, pinned)",
        "build-and-test (macos-latest, 8.5.0)"
      ],
      "dependabot": ["gomod", "opentofu", "github-actions"],
      "bazel_updates": {
        "why": "A library. Its non-dev deps are floors for every downstream module: under Bazel's minimal version selection, bumping them here would force the same versions on users. CI requires the nested workspaces' .bazelversion files to match the root's. The pull requests wait for a person to merge them.",
        "skip_modules": ["platforms", "rules_go", "gazelle"],
        "bazelversion_files": [
          ".bazelversion",
          "e2e/*/.bazelversion",
          "tests/integration/*/.bazelversion"
        ],
        "auto_merge": false
      }
    },
    "song-of-time": {
      "visibility": "private",
      "build": "nix",
      "required_checks": ["termina", "windfall"],
      "dependabot": ["github-actions", "gomod"]
    },
    "tlog-viewer": {
      "build": "bazel",
      "required_checks": ["test"],
      "dependabot": ["npm", "gomod", "github-actions"],
      "pages": { "target": "//:site", "domain": "tlog.benbirt.io" }
    }
  },
  "unmanaged": {
    "2dRPG": "No ruleset or shared automation; last pushed in July 2026.",
    "C2SP": "Fork, kept for pull requests to the upstream repository.",
    "bazel-central-registry": "Fork, kept for pull requests to the upstream repository.",
    "cv": "No ruleset or shared automation; last pushed in May 2026.",
    "git-witness": "No ruleset or shared automation.",
    "rules_tinygo": "Fork; its workflows are the upstream repository's.",
    "tessera": "Fork, kept for pull requests to the upstream repository.",
    "transparency-dev-formats": "Fork, kept for pull requests to the upstream repository."
  }
}
