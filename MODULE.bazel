module(
    name = "github_infra",
    version = "0.0.0",
)

# Compiles repos.jsonnet, the list of repositories, to JSON.
bazel_dep(name = "rules_jsonnet", version = "0.7.2")

# The C++ Jsonnet: the compiler, and the jsonnetfmt that //tools:format runs.
# rules_jsonnet's default, the Go one, needs newer rules_go, jsonnet_go and Go
# pins than rules_jsonnet asks for before it loads under Bazel 9.
bazel_dep(name = "jsonnet", version = "0.22.0")

jsonnet = use_extension("@rules_jsonnet//jsonnet:extensions.bzl", "jsonnet")
jsonnet.compiler(name = "cpp")

# Formatting and Starlark lint from benbirt/bazel-style: bazel run
# //tools:format, //tools:format.check and //tools:lint.
bazel_dep(name = "bazel_style", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "bazel_style",
    commit = "66fd19756990004798c5d1ab56f299151b0a6a72",
    remote = "https://github.com/benbirt/bazel-style.git",
)
